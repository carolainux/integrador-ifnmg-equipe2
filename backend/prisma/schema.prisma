// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  telefone  String   @unique
  criado_em DateTime @default(now())

  plantacoes Plantacao[]
  alertas    Alerta[]

  @@map("usuario")
}

enum tipoSensor {
  temperatura
  umidade_ar   @map("Umidade do Ar")
  umidade_solo @map("Umidade do Solo")
  luminosidade
}

enum tipoAlerta {
  Atencao
  Critico
}

enum direcaoAlerta {
  ABAIXO
  ACIMA
}

enum tipoDispositivo {
  Arduino_Mega     @map("Arduino Mega")
  Arduino_Micro    @map("Arduino Micro")
  Arduino_Nano     @map("Arduino Nano")
  Arduino_Uno      @map("Arduino Uno")
  Arduino_Leonardo @map("Arduino Leonardo")
  ESP32
  ESP8266
}

model Dispositivo {
  id        String            @id @default(uuid())
  nome      String // Ex: "Arduino Mega 2560 - Kit 01"
  tipo      tipoDispositivo
  status    Boolean @default(false)
  criado_em DateTime          @default(now())

  plantacao Plantacao?

  @@map("dispositivo")
}

model Plantacao {
  id                   String    @id @default(uuid())
  usuario_id           String
  dispositivo_id       String    @unique
  nome                 String
  tipo                 String
  data_inicio          DateTime
  data_colheita        DateTime?
  data_proximo_plantio DateTime?
  descricao            String?
  criado_em            DateTime  @default(now())

  usuario     Usuario           @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  dispositivo Dispositivo       @relation(fields: [dispositivo_id], references: [id])
  sensores    PlantacaoSensor[]
  leituras    Leitura[]

  @@map("plantacao")
}

model Sensor {
  id        String        @id @default(uuid())
  nome      String // Ex: "Sensor de Temperatura DHT11"
  tipo      tipoSensor
  unidade   String // Ex: "°C", "%", "Lux"
  status    Boolean @default(false)
  direcao   direcaoAlerta @default(ABAIXO)
  criado_em DateTime      @default(now())

  plantacoes PlantacaoSensor? // permite o sensor não estar em nenhuma plantação

  @@map("sensor")
}

model PlantacaoSensor {
  id             String @id @default(uuid())
  plantacao_id   String
  sensor_id      String @unique
  limite_atencao Float
  limite_critico Float

  plantacao Plantacao @relation(fields: [plantacao_id], references: [id], onDelete: Cascade)
  sensor    Sensor    @relation(fields: [sensor_id], references: [id])

  @@unique([plantacao_id, sensor_id]) // Impede duplicar o mesmo sensor na mesma plantação
  @@map("plantacao_sensor")
}

model Leitura {
  id           String   @id @default(uuid())
  plantacao_id String
  data_hora    DateTime @default(now())
  luminosidade Float?
  temperatura  Float?
  umidade_ar   Float?
  umidade_solo Float?

  plantacao Plantacao @relation(fields: [plantacao_id], references: [id], onDelete: Cascade)
  alertas   Alerta[]

  @@map("leitura")
}

model Alerta {
  id          String     @id @default(uuid())
  leitura_id  String
  usuario_id  String
  tipo        tipoAlerta
  mensagem    String
  notificacao Boolean    @default(false)
  gerado_em   DateTime   @default(now())

  leitura Leitura @relation(fields: [leitura_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("alerta")
}
